# =============================================================================
# Contoh konfigurasi .env untuk Pump Scanner Bot
#
# Cara pakai:
#   1. Salin berkas ini menjadi ".env" di folder yang sama (akar proyek).
#   2. Isi nilainya, lalu simpan.
#   3. Jalankan "python run.py" seperti biasa.
#
# Berkas .env berisi rahasia dan TIDAK ikut terunggah ke GitHub, sebab sudah
# dikecualikan oleh .gitignore (.env.example sendiri tetap disimpan sebagai
# contoh, dikecualikan khusus dengan tanda "!.env.example").
#
# Berkas ini hanya memuat variabel yang benar-benar dibaca bot dari .env.
# Setelan strategi seperti SL/TP/ATR, ukuran posisi, rem risiko, dan tiga
# gerbang entry (arah, zona, timing) TIDAK diambil dari .env. Lokasi
# pengaturannya ada di bagian terakhir.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. MODE OPERASI
# -----------------------------------------------------------------------------
# Pilihan: PAPER atau LIVE.
#
#   PAPER : order, fee, dan saldo DISIMULASIKAN secara lokal. Data pasar tetap
#           data ASLI dari Binance publik (REST + WebSocket), tanpa API key.
#           Ini nilai default dan mode yang aman untuk mencoba-coba.
#   LIVE  : order sungguhan memakai UANG ASLI di Binance produksi.
#
# Isi salah satu saja. Dulu pernah ada nama lama MODE, dan sekarang masih
# didukung. Kalau keduanya diisi dengan nilai berbeda, bot MENOLAK berjalan
# dan menuliskan kesalahannya, jadi cukup pakai BOT_MODE saja.
BOT_MODE=PAPER


# -----------------------------------------------------------------------------
# 2. KREDENSIAL BINANCE
# -----------------------------------------------------------------------------
# Hanya dibutuhkan untuk mode LIVE. Mode PAPER tetap berjalan walau dua baris
# ini dikosongkan atau dihapus.
#
# Ambil dari Binance: Profil > API Management > Create API.
#   - Cukup aktifkan izin perdagangan spot (Enable Spot & Margin Trading).
#   - JANGAN aktifkan izin penarikan (Enable Withdrawals). Bot tidak pernah
#     butuh menarik dana, dan izin itu hanya menambah risiko bila kunci bocor.
#   - Simpan kunci hanya di berkas .env ini, jangan di kode atau screenshot.
#
# Kalau BOT_MODE=LIVE tetapi dua nilai ini kosong, bot berhenti sendiri sebelum
# mengirim order apa pun.
# BINANCE_API_KEY=contoh_format_kunci_anda
# BINANCE_API_SECRET=contoh_format_rahasia_anda
BINANCE_API_KEY=
BINANCE_API_SECRET=


# -----------------------------------------------------------------------------
# 3. DASHBOARD WEB
# -----------------------------------------------------------------------------
# Alamat dan port dashboard. Default: 127.0.0.1 dan 8080, artinya halaman hanya
# bisa dibuka dari komputer yang sama melalui http://127.0.0.1:8080
#
# Kalau DASHBOARD_HOST diisi alamat non-loopback (misalnya 0.0.0.0 supaya bisa
# dipantau dari HP di jaringan rumah), dashboard otomatis berjalan dalam mode
# BACA-SAJA: seluruh tombol kontrol (mulai/hentikan bot, jual sekarang, dan
# backtest) dimatikan, halaman hanya untuk memantau. Bot juga tidak akan
# dijalankan otomatis oleh dashboard dalam kondisi itu.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
#
# Token admin untuk permintaan tulis dashboard (mulai/hentikan bot, jual
# sekarang, backtest). Kalau dibiarkan kosong, dashboard membuat token acak
# untuk proses itu saja, menanamkannya ke halaman, dan token berubah setiap
# dashboard di-restart. Isi minimal 24 karakter di sini bila Anda memakai
# otomasi yang membutuhkan token tetap:
# DASHBOARD_ADMIN_TOKEN=


# -----------------------------------------------------------------------------
# 4. PENGAMAN KHUSUS MODE LIVE
# -----------------------------------------------------------------------------
# Berlaku hanya bila BOT_MODE=LIVE.
#
# Bot LIVE menolak berjalan kalau USE_EQUITY_STOP nonaktif, karena artinya tidak
# ada rem drawdown tingkat akun yang akan menutup posisi saat pasar berbalik
# keras.
#
# Variabel di bawah ini MEMAKSA bot LIVE jalan tanpa rem tersebut. Hanya isi
# bila risiko itu memang disengaja. Nilai yang dianggap mengaktifkan: 1, true,
# yes, atau on. Selama variabel ini aktif, bot menulis peringatan kritis ke log
# setiap kali start.
# ALLOW_LIVE_WITHOUT_ACCOUNT_STOP=1


# -----------------------------------------------------------------------------
# 5. VARIABEL INTERNAL DASHBOARD (JANGAN DIISI MANUAL)
# -----------------------------------------------------------------------------
# Dua variabel ini diisi otomatis oleh dashboard saat ia menjalankan bot sebagai
# proses anak, lalu hilang saat bot ditutup. Dibiarkan sebagai komentar agar
# tidak terisi tanpa sengaja:
#
#   PUMP_BOT_MANAGED_MODE : mode yang dipaksakan proses induk ke bot. Dibaca
#                           SEBELUM berkas .env dimuat, jadi menulisnya di sini
#                           tidak berpengaruh.
#   PUMP_BOT_MANAGED      : penanda "1" bahwa proses ini dikelola dashboard.
#
# PUMP_BOT_MANAGED_MODE=
# PUMP_BOT_MANAGED=


# -----------------------------------------------------------------------------
# 6. SETELAN YANG BUKAN VARIABEL .env
# -----------------------------------------------------------------------------
# Semua setelan strategi dan risiko berada di config/config.py, dan bisa
# ditimpa per mode lewat data/settings.json (nilainya divalidasi otomatis).
# Schema validasi mengelompokkan pengaturan tersebut ke dalam grup:
# "Sistem", "Akun PAPER", "Scan", "Monitoring Pasar", "Konfirmasi Volume",
# "Konfirmasi Demand", "Arah Daily", "Zona H1", "Timing M5",
# "Breakout Retest M5", "SL dan TP",
# "Breakeven dan Trailing", "Ukuran Posisi", "Drawdown", "Fee dan Filter",
# "Data Backtest", dan "Tampilan IDR".
#
# Kunci yang paling sering disesuaikan:
#
#   Arah Daily      : DIRECTION_FILTER_ENABLED, DIRECTION_INTERVAL,
#                      DIRECTION_EMA_FAST, DIRECTION_EMA_SLOW,
#                      DIRECTION_ADX_PERIOD, DIRECTION_ADX_MIN,
#                      DIRECTION_LOOKBACK_BARS
#                      (Default: candle 1d terakhir yang sudah tutup harus
#                       memenuhi Close > EMA20 > EMA50 dan ADX14 >= 25.)
#   Zona dan tren H1: ZONE_FILTER_ENABLED, ZONE_INTERVAL,
#                      ZONE_LOOKBACK_BARS, ZONE_BUFFER_PCT,
#                      ZONE_MAX_DISTANCE_PCT, ZONE_MIN_CLOSE_POSITION,
#                      ZONE_REQUIRE_INSIDE_ZONE, ZONE_EMA_FAST,
#                      ZONE_EMA_SLOW, ZONE_ADX_PERIOD, ZONE_ADX_MIN,
#                      ZONE_TREND_LOOKBACK_BARS
#                      (Default: candle H1 terakhir harus bereaksi di dalam
#                       atau dekat zona demand serta memenuhi
#                       Close > EMA20 > EMA50 dan ADX14 >= 25.)
#   Timing M5       : TIMING_FILTER_ENABLED, TIMING_EMA_FAST,
#                      TIMING_EMA_SLOW, TIMING_ADX_PERIOD, TIMING_ADX_MIN,
#                      TIMING_LOOKBACK_BARS
#                      (Default: candle M5 terakhir yang sudah tutup harus
#                       memenuhi Close > EMA20 > EMA50 dan ADX14 >= 25.)
#   Breakout-retest : BREAKOUT_RETEST_FILTER_ENABLED,
#                      BREAKOUT_LOOKBACK_BARS, BREAKOUT_PIVOT_WING_BARS,
#                      BREAKOUT_ATR_PERIOD, BREAKOUT_RETEST_TOLERANCE_ATR,
#                      BREAKOUT_RETEST_MAX_BARS,
#                      BREAKOUT_RETEST_MAX_TOUCHES,
#                      BREAKOUT_RETEST_REQUIRE_BULLISH
#                      (Default: breakout harus tutup di atas swing high,
#                       lalu dalam 1 sampai 12 candle terjadi retest bullish.
#                       Low candle retest harus masuk area level breakout
#                       dengan toleransi 0,2 ATR dan close kembali di atasnya.)
#   Filter tambahan : DIRECTION_ZONE_FILTER_ENABLED,
#                      ROLLING_VOLUME_FILTER_ENABLED,
#                      DEMAND_ZONE_FILTER_ENABLED
#                      (Ketiganya tetap tersedia tetapi nonaktif secara
#                       default agar alur utama tepat mengikuti strategi baru.)
#   Sinyal pasar    : CONFIRM_INTERVAL, CONFIRM_LOOKBACK_BARS,
#                      PUMP_MIN_24H_CHANGE_PCT, MIN_QUOTE_VOLUME_USDT_24H,
#                      TOP_N_CANDIDATES_TO_CONFIRM
#                      (Batas atas kenaikan 24 jam tidak digunakan. Filter
#                       likuiditas dan ambang minimum tetap menyusun kandidat.)
#   Jendela timeframe: DIRECTION_INTERVAL dan ZONE_INTERVAL wajib kelipatan
#                      bulat dari CONFIRM_INTERVAL dan tidak boleh lebih
#                      pendek, supaya backtest bisa merangkai candle dari
#                      candle konfirmasi.
#   Urutan gerbang  : arah Daily, zona demand plus tren H1, tren M5, lalu
#                      breakout-retest M5. Seluruh keputusan memakai candle
#                      yang sudah tertutup. LIVE, PAPER, dan backtest memakai
#                      fungsi evaluasi yang sama.
#   Filter BTC       : BTC_FILTER_ENABLED, BTC_MAX_DROP_PCT, BTC_LOOKBACK_BARS
#                      (Nonaktif secara default. Kalau aktif dan data BTC gagal
#                       diambil, seluruh kandidat ditolak.)
#   Mode exit        : USE_ATR_EXIT, ATR_PERIOD, ATR_MULT_SL, ATR_MULT_TP,
#                      ATR_MULT_BE_TRIGGER, ATR_MULT_BE_LOCK,
#                      ATR_MULT_TRAIL_START, ATR_MULT_TRAIL
#                      dan padanan persennya: SL_PCT, TP_PCT, BE_TRIGGER_PCT,
#                      BE_LOCK_PCT, TRAILING_START_PCT, TRAILING_STEP_PCT,
#                      MAX_HOLD_HOURS
#   Ukuran posisi    : USE_RISK_PERCENT, RISK_PERCENT, POSITION_SIZE_USDT,
#                      MAX_POSITION_USDT, BALANCE_BUFFER_PCT
#   Rem risiko akun  : USE_EQUITY_STOP, MAX_DRAWDOWN_PERCENT,
#                      DD_COOLDOWN_HOURS, CLOSE_ALL_AT_LIMIT
#                      (Rem harian berbasis loss harian sudah dihapus. Sisa
#                       drawdown dari puncak equity adalah satu-satunya rem
#                       tingkat akun.)
#   Jeda dan blokir  : COOLDOWN_MINUTES_AFTER_CLOSE, MIN_SECONDS_BETWEEN_TRADES,
#                      SAME_COIN_BLOCK_HOURS, SAME_COIN_BLOCK_LOSS_ONLY,
#                      MIN_LISTING_AGE_DAYS, EXTRA_EXCLUDE_SYMBOLS
#   Likuiditas eksekusi: MAX_SPREAD_PCT, MAX_CHASE_PCT, DEPTH_FILTER_ENABLED,
#                        DEPTH_RANGE_PCT, DEPTH_MIN_ASK_NOTIONAL_MULT,
#                        ORDERBOOK_FILTER_ENABLED, ORDERBOOK_LEVELS,
#                        ORDERBOOK_MIN_BID_ASK_RATIO, SELL_WALL_RANGE_PCT,
#                        SELL_WALL_MAX_SHARE_PCT, ORDERBOOK_DEPTH_LIMIT
#                        (Hanya berlaku di PAPER dan LIVE, tidak di backtest.)
#
# Pemeriksaan cepat setelah mengubah apa pun, semuanya tanpa menyentuh Binance.
# Jalankan dari folder akar proyek (folder yang berisi run.py). Perintah di
# bawah sama persis di Windows (CMD atau PowerShell) maupun Linux/macOS, tidak
# perlu mengatur PYTHONPATH karena "python -m" otomatis memakai folder aktif:
#
#   python -m strategy.indicators
#   python -m backtesting.entry_selftest
#   python -m backtesting.exit_selftest
#   python -m backtesting.backtest --selftest
#   python -m backtesting.portfolio_backtest
#   python -m backtesting.grid_search
#   python -m trading.pump_scanner_bot --selftest
#   python -m web.dashboard --selftest
#
#
# -----------------------------------------------------------------------------
# 7. CATATAN WINDOWS DAN LINUX
# -----------------------------------------------------------------------------
# Butuh Python 3.10 atau lebih baru. run.py menolak versi di bawahnya dengan
# pesan yang jelas. Di Windows, pakai "py -3" atau "python" dari python.org;
# di Linux, pakai "python3". Pasang dependensi dengan:
#
#   python -m pip install -r requirements.txt
#
# Menghentikan dashboard: tekan Ctrl+C di jendela terminal, lalu tunggu sampai
# muncul catatan pembersihan. Dashboard akan menghentikan bot secara graceful
# (menyimpan state dulu). Jangan menutup jendela terminal secara paksa atau
# menekan Ctrl+Break: di Windows itu mematikan bot seketika lewat Job Object,
# tanpa kesempatan menyimpan state terakhir.
#
# Semua file runtime (state, lock, log, ledger) selalu berada di folder data/
# dan logs/ di dalam akar proyek, apa pun folder tempat perintah dijalankan.
# =============================================================================
