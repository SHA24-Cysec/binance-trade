# Salin menjadi .env lalu isi. JANGAN pernah men-commit file .env.

# Mode aktif. Pilihan hanya PAPER atau LIVE.
# Sebelum mengubahnya, tutup posisi dan hentikan bot pada mode lama.
# Setelah mengubah nilai ini, jalankan ulang dashboard.
BOT_MODE=PAPER

# Kredensial Binance Spot (WAJIB untuk BOT_MODE=LIVE)
BINANCE_API_KEY=isi_api_key_anda_di_sini
BINANCE_API_SECRET=isi_api_secret_anda_di_sini

# Alamat jaringan dashboard (default hanya localhost, paling aman dibiarkan)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080

# Penanda proses dikelola induk. DISETEL OTOMATIS oleh runtime_control saat
# bot dijalankan lewat run.py; tidak perlu disetel manual.
# PUMP_BOT_MANAGED=1

# === REM BAHAYA: JANGAN disetel kecuali benar-benar disengaja ===
# Mengizinkan LIVE tanpa rem drawdown maupun rem kerugian harian.
# Kode: fungsi account_risk_gate() di trading/pump_scanner_bot.py
# ALLOW_LIVE_WITHOUT_ACCOUNT_STOP=
