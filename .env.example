# Contoh file .env -- SALIN file ini jadi ".env" (tanpa akhiran .example),
# lalu isi dengan API key/secret Binance Anda yang sebenarnya.
#
# File ".env" (hasil salinan) TIDAK akan ter-commit ke Git karena sudah
# masuk daftar .gitignore. File ".env.example" ini AMAN di-commit karena
# tidak berisi kredensial asli, hanya contoh format.
#
# Cara pakai:
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# lalu buka file .env dengan editor teks dan ganti nilai di bawah ini.

# PENTING soal mode (lihat "MODE" di config.py):
#   MODE="PAPER" (default) -> TIDAK PERLU API key sama sekali. Data pasar
#                             diambil ASLI dari endpoint publik Binance
#                             produksi (tanpa tanda tangan), sedangkan
#                             eksekusi order, fee, dan saldo disimulasikan
#                             lokal (akun demo dengan saldo virtual, lihat
#                             PAPER_INITIAL_BALANCES di config.py). Kedua
#                             variabel di bawah boleh dibiarkan kosong /
#                             apa adanya.
#   MODE="LIVE"            -> WAJIB diisi API key + secret PRODUKSI dari
#                             Binance (order sungguhan, uang asli).
#                             Aktifkan hanya permission "Enable Spot
#                             Trading"; JANGAN aktifkan "Enable
#                             Withdrawals".
# Catatan: mode "TESTNET" lama (testnet.binance.vision) sudah DIHAPUS dan
# digantikan mode PAPER di atas. Kalau MODE diisi nilai selain PAPER/LIVE,
# bot menolak start dengan error "MODE tidak valid".

BINANCE_API_KEY=isi_api_key_anda_di_sini
BINANCE_API_SECRET=isi_api_secret_anda_di_sini
