# Contoh file .env -- SALIN file ini jadi ".env" (tanpa akhiran .example),
# lalu isi dengan API key/secret Binance Anda yang sebenarnya.
#
# File ".env" (hasil salinan) TIDAK akan ter-commit ke Git karena sudah
# masuk daftar .gitignore. File ".env.example" ini AMAN di-commit karena
# tidak berisi kredensial asli, hanya contoh format.
#
# Cara pakai:
#   Linux/macOS : cp .env.example .env
#   Windows     : copy .env.example .env
# lalu buka file .env dengan editor teks dan ganti nilai di bawah ini.

BINANCE_API_KEY=isi_api_key_anda_di_sini
BINANCE_API_SECRET=isi_api_secret_anda_di_sini
