+def print_comparison(cmp_result: dict, config: dict) -> None:
+    f = cmp_result["fixed"]
+    a = cmp_result["atr"]
+    info = cmp_result["atr_info"]
+
+    def row(label, kf, ka, fmt="{:.2f}", higher_better=True):
+        vf, va = kf, ka
+        try:
+            delta = va - vf
+            arrow = ""
